{
  "uid": "homelabs-kubernetes-overview",
  "title": "Homelabs / Kubernetes overview",
  "tags": ["homelabs", "kubernetes"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${metrics_datasource_uid}" },
        "definition": "label_values(kube_node_info, cluster)",
        "query": { "query": "label_values(kube_node_info, cluster)", "refId": "Cluster" },
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Nodes ready",
      "datasource": { "type": "prometheus", "uid": "${metrics_datasource_uid}" },
      "targets": [{ "expr": "sum(kube_node_status_condition{cluster=~\"$cluster\",condition=\"Ready\",status=\"true\"})", "refId": "A" }],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Unavailable workload replicas",
      "datasource": { "type": "prometheus", "uid": "${metrics_datasource_uid}" },
      "targets": [{ "expr": "sum(kube_deployment_spec_replicas{cluster=~\"$cluster\"} - kube_deployment_status_replicas_available{cluster=~\"$cluster\"})", "refId": "A" }],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "textMode": "auto" }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Argo CD applications by health status",
      "datasource": { "type": "prometheus", "uid": "${metrics_datasource_uid}" },
      "targets": [{ "expr": "sum by (health_status) (argocd_app_info)", "legendFormat": "{{health_status}}", "refId": "A" }],
      "gridPos": { "h": 10, "w": 16, "x": 0, "y": 8 }
    }
  ]
}
